{$SITE_ADDRESS} {
	encode zstd gzip

	@backend path /api/* /ws /ws/* /socket /ping
	handle @backend {
		reverse_proxy backend:5000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
